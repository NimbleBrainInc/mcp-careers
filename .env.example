# Local development. Every value here has a working default except SLACK_WEBHOOK_URL.
# Turnstile's published test keys always pass; use real keys in staging and production.
CAREERS_ENV=development
CAREERS_PUBLIC_URL=http://127.0.0.1:8000
REDIS_URL=redis://127.0.0.1:6379/0
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
